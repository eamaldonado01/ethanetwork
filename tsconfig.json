{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    // ▼ add cypress here ▼
    "types": ["node", "jest", "cypress"],
    // ▲ end types ▲

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "tests/**/*.ts",
    ".next/types/**/*.ts",
    "src/**/*",
    "cypress/e2e/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
