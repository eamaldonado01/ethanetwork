{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/lib/*": ["src/lib/*"],
      "@/types": ["src/types/index.ts"]
    },

    "types": ["node", "jest", "cypress", "react", "react-dom", "next"],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "tests/**/*.ts",
    ".next/types/**/*.ts",
    "src/**/*",
    "cypress/e2e/**/*.ts",
    "src/types/**/*.d.ts",
    "next.config.cjs",
    "next.config.mjs"
  ],
  "exclude": ["node_modules", ".next", "tests", "**/*.test.ts", "**/*.test.tsx"]
}
