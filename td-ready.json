{
  "containerDefinitions": [
    {
      "name": "web",
      "image": "468381823872.dkr.ecr.us-west-1.amazonaws.com/odin-book:20250529-1953",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "name": "web-3000-tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "S3_BUCKET",
          "value": "odin-media-1"
        },
        {
          "name": "NEXT_PUBLIC_AUTH0_BASE_URL",
          "value": "https://ethanetwork.com"
        },
        {
          "name": "S3_REGION",
          "value": "us-west-1"
        },
        {
          "name": "AUTH0_COOKIE_SECURE",
          "value": "true"
        },
        {
          "name": "NEXT_PUBLIC_SITE_URL",
          "value": "https://ethanetwork.com"
        },
        {
          "name": "AUTH0_COOKIE_SAME_SITE",
          "value": "none"
        },
        {
          "name": "AUTH0_BASE_URL",
          "value": "https://ethanetwork.com"
        },
        {
          "name": "AUTH0_AUDIENCE",
          "value": "https://odin-book.local/graphql"
        },
        {
          "name": "AUTH0_COOKIE_DOMAIN",
          "value": ".ethanetwork.com"
        },
        {
          "name": "SITE_URL",
          "value": "https://ethanetwork.com"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "AUTH0_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:468381823872:secret:/ethanetwork/auth0-F1HWuo:AUTH0_CLIENT_ID::"
        },
        {
          "name": "AUTH0_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:468381823872:secret:/ethanetwork/auth0-F1HWuo:AUTH0_CLIENT_SECRET::"
        },
        {
          "name": "AUTH0_ISSUER_BASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:468381823872:secret:/ethanetwork/auth0-F1HWuo:AUTH0_ISSUER_BASE_URL::"
        },
        {
          "name": "AUTH0_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:468381823872:secret:/ethanetwork/auth0-F1HWuo:AUTH0_SECRET::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:us-west-1:468381823872:parameter/odin/REDIS_URL"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-west-1:468381823872:parameter/odin/DATABASE_URL"
        },
        {
          "name": "INTERNAL_GRAPHQL_URL",
          "valueFrom": "arn:aws:ssm:us-west-1:468381823872:parameter/odin/INTERNAL_GRAPHQL_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/odin-service",
          "awslogs-region": "us-west-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "odin-service",
  "taskRoleArn": "arn:aws:iam::468381823872:role/odin-task-exec",
  "executionRoleArn": "arn:aws:iam::468381823872:role/odin-task-exec",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
