{
  "name": "odin-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:cov": "cross-env NODE_ENV=test c8 --reporter=lcov npm test",
    "cy": "cypress open",
    "cy:run": "cypress run",
    "prepare": "husky",
    "db:seed": "NODE_OPTIONS='--loader ts-node/esm' ts-node prisma/seed.ts",
    "generate": "graphql-codegen --schema http://localhost:3000/api/graphql --documents 'src/graphql/**/*.graphql' 'src/graphql/fragments/*.graphql' --config codegen.yml",
    "e2e": "start-server-and-test dev http://localhost:3000 cy:run"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@apollo/server": "^4.12.1",
    "@as-integrations/next": "^3.2.0",
    "@auth0/nextjs-auth0": "^3.5.0",
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.817.0",
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "apollo-server-micro": "^3.13.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^7.5.0",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.24.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jwks-rsa": "^3.2.0",
    "lucide-react": "^0.511.0",
    "next": "^14.2.29",
    "next-connect": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swr": "^2.3.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.8.0",
    "@graphql-codegen/import-types-preset": "^3.0.0",
    "@parcel/watcher": "^2.5.1",
    "@prisma/client": "^6.8.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/cypress": "^10.0.3",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.18",
    "@types/cypress": "^0.1.6",
    "@types/express": "^5.0.2",
    "@types/express-jwt": "^6.0.4",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.50",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/redis": "^4.0.10",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.3",
    "commitlint": "^19.8.1",
    "cross-env": "^7.0.3",
    "cypress": "^14.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.29",
    "eslint-import-resolver-typescript": "^4.4.0",
    "esm": "^3.2.25",
    "graphql-tag": "^2.12.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.8.2",
    "start-server-and-test": "^2.0.12",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "ts-jest": "^29.3.4",
    "typescript": "^5"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": "eslint --fix",
    "*.{js,ts,jsx,tsx,css,md,json}": "prettier --write"
  }
}
